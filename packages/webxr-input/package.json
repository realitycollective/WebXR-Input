{
  "name": "@realitycollective/webxr-input",
  "version": "0.1.3-preview.0",
  "description": "Shared, engine-free input contracts for the Reality Collective WebXR extension families: normalised input sources (rays, pinches, pokes, grips, hand joints, gaze, 2D pointers), capability negotiation, a pull-based provider interface, and pointer streams - consumable by the Interactions and UI Extensions families alike. Zero dependencies.",
  "keywords": [
    "realitycollective",
    "webxr",
    "xr",
    "input",
    "openxr",
    "contracts",
    "typescript"
  ],
  "license": "MIT",
  "author": "Reality Collective",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realitycollective/WebXR-Input.git",
    "directory": "packages/webxr-input"
  },
  "homepage": "https://github.com/realitycollective/WebXR-Input#readme",
  "bugs": {
    "url": "https://github.com/realitycollective/WebXR-Input/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
