{
  "name": "webxr-input-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workspace for the Reality Collective WebXR Input contracts - shared, engine-free input contracts consumed by the Interactions and UI Extensions families.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace @realitycollective/webxr-input run build",
    "typecheck": "npm --workspace @realitycollective/webxr-input run typecheck",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
